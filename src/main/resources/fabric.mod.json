{
	"schemaVersion": 1,
	"id": "skyblock-shopping-list",
	"version": "${version}",
	"name": "Skyblock Shopping List",
	"description": "Hypixel SkyBlock shopping-list HUD. Tracks the items in your inventory, sacks and storage, and shows what you still need for the recipes you pick. Read-only and client-side.",
	"authors": [
		"Tad"
	],
	"contributors": [
		"Scholiboi (original Inventory Reader)"
	],
	"contact": {
		"homepage": "https://github.com/Toakan/Skyblock-Shopping-List",
		"sources": "https://github.com/Toakan/Skyblock-Shopping-List",
		"issues": "https://github.com/Toakan/Skyblock-Shopping-List/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/skyblock-shopping-list/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"inventoryreader.ir.InventoryReaderClient"
		],
		"skyblock-item-list": [
			"inventoryreader.ir.compat.ItemListPlugin"
		],
		"modmenu": [
			"inventoryreader.ir.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"skyblock-shopping-list.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ["~26.2", "~26.3"],
		"java": ">=25",
		"fabric-api": ">=0.161.0",
		"yet_another_config_lib_v3": ">=3.9.7",
		"hypixel-mod-api": ">=1.0.2"
	},
	"suggests": {
		"skyblock-item-list": "*",
		"modmenu": "*"
	},
	"breaks": {
		"ir": "*"
	}
}
